+"""
+Tests for: live tracking (Superadmin), worker path, profile pictures, late-ping guard.
+
+Run:  python manage.py test accounts.test_tracking_profile_picture
+"""
+import base64
+import io
+from datetime import timedelta
+
+from django.contrib.auth.models import User
+from django.test import TestCase, override_settings
+from django.utils import timezone
+from rest_framework.test import APIClient
+
+from .models import Attendance, Project, Role, UserProjectRole, WorkerLocation
+
+LIVE = '/api/dashboard/live-locations/'
+PATH = '/api/dashboard/worker-path/'
+
+
+def _jpeg(size=(48, 48), color=(200, 30, 30)):
+    from PIL import Image
+    buf = io.BytesIO()
+    Image.new('RGB', size, color).save(buf, 'JPEG')
+    return buf.getvalue()
+
+
+def _b64(b):
+    return base64.b64encode(b).decode()
+
+
+class Base(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        cls.project = Project.objects.create(name='Planeteye(Nashik)')
+        cls.se = User.objects.create_user('se1', first_name='Site', last_name='Eng', password='x')
+        cls.se2 = User.objects.create_user('se2', password='x')
+        cls.project.site_engineers.add(cls.se)
+        cls.tl = User.objects.create_user('tl1', password='x')
+        cls.pm = User.objects.create_user('pm1', password='x')
+        cls.staff = User.objects.create_user('staff1', password='x', is_staff=True)
+        cls.sa = User.objects.create_superuser('sa1', password='x')
+        for u, rn in ((cls.tl, 'TEAM_LEAD'), (cls.pm, 'PROJECT_MANAGER')):
+            role, _ = Role.objects.get_or_create(name=rn)
+            UserProjectRole.objects.create(user=u, project=cls.project, role=role)
+
+    def client_for(self, user):
+        c = APIClient()
+        c.force_authenticate(user)
+        return c
+
+    def add_path(self, user=None, n=4, inside_last=False):
+        user = user or self.se
+        now = timezone.now()
+        pts = [(19.9900, 73.7800), (19.9910, 73.7810), (19.9925, 73.7825), (19.9940, 73.7840)][:n]
+        for i, (la, lo) in enumerate(pts):
+            WorkerLocation.objects.create(
+                worker=user, latitude=la, longitude=lo,
+                timestamp=now - timedelta(minutes=10 * (len(pts) - 1 - i) + 2),
+                project_name=self.project.name, current_zone='Block-A',
+                inside_project=(inside_last or i != len(pts) - 1),
+            )
+        Attendance.objects.create(
+            worker=user, project_name=self.project.name, date=now.date(),
+            check_in=now - timedelta(minutes=45), status='ACTIVE',
+        )
+        return now
+
+
+class LiveLocationsTests(Base):
+    def test_superadmin_sees_latest_position_and_live_flag(self):
+        self.add_path()
+        r = self.client_for(self.sa).get(LIVE)
+        self.assertEqual(r.status_code, 200)
+        self.assertEqual(r.data['count'], 1)
+        row = r.data['results'][0]
+        self.assertEqual(row['worker_id'], self.se.id)
+        self.assertTrue(row['is_live'])
+        self.assertEqual(row['attendance_status'], 'ACTIVE')
+        self.assertAlmostEqual(row['latitude'], 19.9940, places=4)  # latest ping, not the first
+
+    def test_stale_ping_is_not_live(self):
+        WorkerLocation.objects.create(
+            worker=self.se, latitude=19.99, longitude=73.78,
+            timestamp=timezone.now() - timedelta(minutes=40), project_name=self.project.name)
+        Attendance.objects.create(worker=self.se, project_name=self.project.name,
+                                  date=timezone.now().date(), check_in=timezone.now() - timedelta(hours=1), status='ACTIVE')
+        row = self.client_for(self.sa).get(LIVE).data['results'][0]
+        self.assertFalse(row['is_live'])
+        self.assertGreaterEqual(row['minutes_since_update'], 40)
+
+    def test_project_filter(self):
+        self.add_path()
+        c = self.client_for(self.sa)
+        self.assertEqual(c.get(LIVE, {'project_name': 'Other'}).data['count'], 0)
+        self.assertEqual(c.get(LIVE, {'project_name': self.project.name}).data['count'], 1)
+
+    def test_only_superadmin_by_default(self):
+        for u in (self.tl, self.pm, self.se, self.staff):
+            self.assertEqual(self.client_for(u).get(LIVE).status_code, 403, u.username)
+        self.assertEqual(APIClient().get(LIVE).status_code, 401)
+
+    @override_settings(TRACKING_VIEW_ROLES={'SUPER_ADMIN', 'TEAM_LEAD'})
+    def test_tracking_view_roles_setting_extends_access(self):
+        self.assertEqual(self.client_for(self.tl).get(LIVE).status_code, 200)
+        self.assertEqual(self.client_for(self.pm).get(LIVE).status_code, 403)
+
+
+class WorkerPathTests(Base):
+    def test_path_is_ascending_with_distance_and_summary(self):
+        now = self.add_path()
+        r = self.client_for(self.sa).get(PATH, {
+            'worker_id': self.se.id,
+            'from': (now - timedelta(hours=3)).isoformat(), 'to': (now + timedelta(hours=1)).isoformat()})
+        self.assertEqual(r.status_code, 200)
+        times = [p['timestamp'] for p in r.data['points']]
+        self.assertEqual(times, sorted(times))
+        s = r.data['summary']
+        self.assertEqual(s['point_count'], 4)
+        self.assertGreater(s['distance_meters'], 400)
+        self.assertEqual(s['outside_project_points'], 1)
+        self.assertEqual(r.data['points'][1]['gap_minutes'], 10)
+        self.assertEqual(r.data['attendance']['status'], 'ACTIVE')
+
+    def test_date_parameter_and_validation(self):
+        self.add_path()
+        c = self.client_for(self.sa)
+        self.assertEqual(c.get(PATH, {'worker_id': self.se.id, 'date': str(timezone.localdate())}).status_code, 200)
+        self.assertEqual(c.get(PATH).status_code, 400)
+        self.assertEqual(c.get(PATH, {'worker_id': 999999}).status_code, 400)
+
+    def test_forbidden_for_non_superadmin(self):
+        for u in (self.tl, self.pm, self.se):
+            self.assertEqual(self.client_for(u).get(PATH, {'worker_id': self.se.id}).status_code, 403)
+
+    def test_late_ping_appears_in_time_order(self):
+        now = timezone.now()
+        for minutes_ago, lat in ((40, 19.990), (0, 19.995), (20, 19.992)):   # stored out of order
+            WorkerLocation.objects.create(worker=self.se, latitude=lat, longitude=73.78,
+                                          timestamp=now - timedelta(minutes=minutes_ago), project_name='P')
+        r = self.client_for(self.sa).get(PATH, {
+            'worker_id': self.se.id,
+            'from': (now - timedelta(hours=2)).isoformat(), 'to': (now + timedelta(hours=1)).isoformat()})
+        self.assertEqual([round(p['latitude'], 3) for p in r.data['points']], [19.990, 19.992, 19.995])
+
+
+class LatePingGuardTests(Base):
+    """POST /api/worker/location/ with an older timestamp must not move check_out backwards."""
+
+    def ping(self, minutes_ago):
+        now = self.now
+        return self.client_for(self.se).post('/api/worker/location/', {
+            'worker_id': self.se.id, 'latitude': 19.99, 'longitude': 73.78,
+            'timestamp': (now - timedelta(minutes=minutes_ago)).isoformat()}, format='json')
+
+    def test_old_ping_is_stored_but_check_out_not_moved_back(self):
+        self.now = timezone.now().replace(microsecond=0)
+        for m in (40, 30, 0):
+            self.assertEqual(self.ping(m).status_code, 201)
+        att = Attendance.objects.get(worker=self.se)
+        self.assertEqual(att.check_out, self.now)
+        before = att.total_duration
+
+        self.assertEqual(self.ping(20).status_code, 201)            # late, queued ping
+        att.refresh_from_db()
+        self.assertEqual(att.check_out, self.now)                   # unchanged
+        self.assertEqual(att.total_duration, before)
+        self.assertEqual(WorkerLocation.objects.filter(worker=self.se).count(), 4)  # still on the path
+
+    def test_in_order_pings_still_advance_check_out(self):
+        self.now = timezone.now().replace(microsecond=0)
+        self.ping(30)
+        self.ping(20)
+        self.ping(10)
+        self.assertEqual(Attendance.objects.get(worker=self.se).check_out, self.now - timedelta(minutes=10))
+
+
+class ProfilePictureTests(Base):
+    def url(self, user=None):
+        return f'/api/accounts/users/{(user or self.se).id}/profile-picture/'
+
+    def test_upload_read_replace_delete(self):
+        c = self.client_for(self.se)
+        self.assertEqual(c.get(self.url()).status_code, 404)
+
+        r = c.post(self.url(), {'image_base64': _b64(_jpeg())}, format='json')
+        self.assertEqual(r.status_code, 201)
+        self.assertEqual(r.data['content_type'], 'image/jpeg')
+
+        g = c.get(self.url())
+        self.assertEqual(g.status_code, 200)
+        self.assertEqual(g['Content-Type'], 'image/jpeg')
+        self.assertEqual(g.content[:3], b'\xff\xd8\xff')
+
+        # replace (PUT) keeps one row
+        self.assertEqual(c.put(self.url(), {'image_base64': _b64(_jpeg(color=(0, 0, 255)))}, format='json').status_code, 201)
+        from .profile_picture_model import ProfilePicture
+        self.assertEqual(ProfilePicture.objects.filter(user=self.se).count(), 1)
+
+        self.assertEqual(c.delete(self.url()).status_code, 204)
+        self.assertEqual(c.get(self.url()).status_code, 404)
+
+    def test_data_uri_prefix_is_accepted(self):
+        r = self.client_for(self.se).post(
+            self.url(), {'image_base64': 'data:image/jpeg;base64,' + _b64(_jpeg())}, format='json')
+        self.assertEqual(r.status_code, 201)
+
+    def test_validation(self):
+        c = self.client_for(self.se)
+        self.assertEqual(c.post(self.url(), {}, format='json').status_code, 400)
+        self.assertEqual(c.post(self.url(), {'image_base64': '!!!notbase64!!!'}, format='json').status_code, 400)
+        self.assertEqual(c.post(self.url(), {'image_base64': _b64(b'plain text, not an image')}, format='json').status_code, 400)
+        too_big = b'\xff\xd8\xff' + b'0' * (300 * 1024 + 10)
+        self.assertEqual(c.post(self.url(), {'image_base64': _b64(too_big)}, format='json').status_code, 400)
+
+    def test_permissions(self):
+        self.client_for(self.se).post(self.url(), {'image_base64': _b64(_jpeg())}, format='json')
+        # read: self, superadmin, managers (TL/PM/staff) – not other engineers
+        for u, code in ((self.se, 200), (self.sa, 200), (self.tl, 200), (self.pm, 200), (self.staff, 200), (self.se2, 403)):
+            self.assertEqual(self.client_for(u).get(self.url()).status_code, code, u.username)
+        # write: self and superadmin only
+        body = {'image_base64': _b64(_jpeg())}
+        for u, code in ((self.sa, 201), (self.tl, 403), (self.pm, 403), (self.staff, 403), (self.se2, 403)):
+            self.assertEqual(self.client_for(u).post(self.url(), body, format='json').status_code, code, u.username)
+        self.assertEqual(self.client_for(self.tl).delete(self.url()).status_code, 403)
+        self.assertEqual(APIClient().get(self.url()).status_code, 401)
+        self.assertEqual(self.client_for(self.sa).get('/api/accounts/users/999999/profile-picture/').status_code, 404)
+
+    def test_me_returns_picture_flags(self):
+        c = self.client_for(self.se)
+        me = c.get('/api/accounts/me/').data
+        self.assertFalse(me['has_profile_picture'])
+        self.assertIsNone(me['profile_picture_updated_at'])
+        c.post(self.url(), {'image_base64': _b64(_jpeg())}, format='json')
+        me = c.get('/api/accounts/me/').data
+        self.assertTrue(me['has_profile_picture'])
+        self.assertTrue(me['profile_picture_updated_at'])
+
+    def test_picture_flag_in_live_locations(self):
+        self.add_path()
+        self.client_for(self.se).post(self.url(), {'image_base64': _b64(_jpeg())}, format='json')
+        row = self.client_for(self.sa).get(LIVE).data['results'][0]
+        self.assertTrue(row['has_profile_picture'])
