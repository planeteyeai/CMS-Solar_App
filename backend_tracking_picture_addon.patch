@@ -0,0 +1,310 @@
+"""
+Live tracking + profile pictures (mobile app).
+
+GET    /api/dashboard/live-locations/?project_name=&since_hours=16   latest position of every tracked worker  (superadmin)
+GET    /api/dashboard/worker-path/?worker_id=&date= | &from=&to=     the path a worker travelled             (superadmin)
+GET    /api/accounts/users/<id>/profile-picture/                     image bytes
+POST   /api/accounts/users/<id>/profile-picture/   (or PUT)          {"image_base64": "...", "content_type": "image/jpeg"}
+DELETE /api/accounts/users/<id>/profile-picture/
+"""
+import base64
+import binascii
+import math
+from datetime import datetime, time, timedelta
+
+from django.conf import settings
+from django.contrib.auth.models import User
+from django.http import HttpResponse
+from django.utils import timezone
+from django.utils.dateparse import parse_date, parse_datetime
+from rest_framework import status as http
+from rest_framework.permissions import IsAuthenticated
+from rest_framework.response import Response
+from rest_framework.views import APIView
+
+from .models import Attendance, UserProjectRole, WorkerLocation
+from .profile_picture_model import ProfilePicture
+
+MAX_PICTURE_BYTES = 300 * 1024
+MAX_PATH_POINTS = 2000
+LIVE_STALE_MINUTES = 25   # a worker pinging every 10 min is "live" while the last ping is newer than this
+
+
+# ── permissions ────────────────────────────────────────────────────────────
+# Self-contained on purpose: nothing here imports helpers from views.py or
+# site_roles.py, so this module keeps working if those are refactored.
+
+SUPER_ADMIN_NAMES = {'SUPER_ADMIN', 'Super Admin'}
+
+# Roles that may READ a profile picture of any user (never write).
+MANAGER_ROLE_NAMES = {
+    'SUPER_ADMIN', 'Super Admin', 'PMC_HEAD', 'PMC Head',
+    'PROJECT_MANAGER', 'Project Manager', 'TEAM_LEAD', 'Team Lead', 'Team Leader',
+    'COORDINATOR', 'Coordinator',
+}
+
+
+def _roles(user):
+    names = set(user.groups.values_list('name', flat=True))
+    names |= set(UserProjectRole.objects.filter(user=user).values_list('role__name', flat=True))
+    return names
+
+
+def _can_view_tracking(user):
+    """Superadmin only by default. Extend with settings.TRACKING_VIEW_ROLES (no code change)."""
+    if user.is_superuser:
+        return True
+    allowed = set(getattr(settings, 'TRACKING_VIEW_ROLES', SUPER_ADMIN_NAMES))
+    return bool(_roles(user) & allowed)
+
+
+def _is_manager(user):
+    return bool(user.is_superuser or user.is_staff or (_roles(user) & MANAGER_ROLE_NAMES))
+
+
+def _forbidden(msg):
+    return Response({'detail': msg}, status=http.HTTP_403_FORBIDDEN)
+
+
+def _name(u):
+    return (u.get_full_name() or u.username).strip()
+
+
+# ── helpers ────────────────────────────────────────────────────────────────
+
+def haversine_m(lat1, lon1, lat2, lon2):
+    r = 6371000.0
+    p1, p2 = math.radians(lat1), math.radians(lat2)
+    dp, dl = p2 - p1, math.radians(lon2 - lon1)
+    a = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
+    return 2 * r * math.asin(min(1.0, math.sqrt(a)))
+
+
+def _picture_info(user_ids):
+    """{user_id: updated_at} for users that have a picture."""
+    return dict(ProfilePicture.objects.filter(user_id__in=user_ids).values_list('user_id', 'updated_at'))
+
+
+# ── live positions ─────────────────────────────────────────────────────────
+
+class LiveLocationsView(APIView):
+    permission_classes = [IsAuthenticated]
+
+    def get(self, request):
+        if not _can_view_tracking(request.user):
+            return _forbidden('Only the superadmin can view live tracking.')
+
+        try:
+            hours = max(1, min(int(request.query_params.get('since_hours', 16)), 72))
+        except ValueError:
+            hours = 16
+        now = timezone.now()
+        since = now - timedelta(hours=hours)
+
+        qs = WorkerLocation.objects.filter(timestamp__gte=since).select_related('worker')
+        project = (request.query_params.get('project_name') or '').strip()
+        if project:
+            qs = qs.filter(project_name=project)
+
+        latest = {}
+        for loc in qs.order_by('-timestamp')[:20000]:
+            latest.setdefault(loc.worker_id, loc)
+
+        att = {}
+        for a in Attendance.objects.filter(worker_id__in=latest.keys(), check_in__gte=since).order_by('check_in'):
+            att[a.worker_id] = a  # newest wins
+
+        pics = _picture_info(latest.keys())
+        rows = []
+        for wid, loc in latest.items():
+            a = att.get(wid)
+            minutes = int((now - loc.timestamp).total_seconds() // 60)
+            is_live = (a is not None and a.status == Attendance.Status.ACTIVE and minutes <= LIVE_STALE_MINUTES)
+            rows.append({
+                'worker_id': wid,
+                'username': loc.worker.username,
+                'full_name': _name(loc.worker),
+                'has_profile_picture': wid in pics,
+                'profile_picture_updated_at': pics.get(wid),
+                'latitude': float(loc.latitude),
+                'longitude': float(loc.longitude),
+                'timestamp': loc.timestamp,
+                'minutes_since_update': minutes,
+                'zone': loc.current_zone,
+                'project_name': loc.project_name,
+                'inside_project': loc.inside_project,
+                'attendance_status': a.status if a else None,
+                'check_in': a.check_in if a else None,
+                'check_out': a.check_out if a else None,
+                'is_live': is_live,
+            })
+        rows.sort(key=lambda r: (not r['is_live'], r['minutes_since_update']))
+        return Response({'count': len(rows), 'updated_at': now, 'results': rows})
+
+
+# ── path ───────────────────────────────────────────────────────────────────
+
+class WorkerPathView(APIView):
+    permission_classes = [IsAuthenticated]
+
+    def get(self, request):
+        if not _can_view_tracking(request.user):
+            return _forbidden('Only the superadmin can view worker paths.')
+
+        worker_id = request.query_params.get('worker_id')
+        worker = User.objects.filter(pk=worker_id).first() if worker_id else None
+        if worker is None:
+            return Response({'detail': 'A valid worker_id is required.'}, status=http.HTTP_400_BAD_REQUEST)
+
+        # Time window: explicit UTC range (preferred; the app sends its local day) or a calendar date.
+        start = parse_datetime(request.query_params.get('from', '') or '')
+        end = parse_datetime(request.query_params.get('to', '') or '')
+        if start is None or end is None:
+            d = parse_date(request.query_params.get('date', '') or '') or timezone.localdate()
+            tz = timezone.get_current_timezone()
+            start = timezone.make_aware(datetime.combine(d, time.min), tz)
+            end = start + timedelta(days=1)
+        if timezone.is_naive(start):
+            start = timezone.make_aware(start, timezone.utc)
+        if timezone.is_naive(end):
+            end = timezone.make_aware(end, timezone.utc)
+
+        locs = list(
+            WorkerLocation.objects.filter(worker=worker, timestamp__gte=start, timestamp__lt=end)
+            .order_by('timestamp')[:MAX_PATH_POINTS]
+        )
+
+        points, total, outside, prev = [], 0.0, 0, None
+        for loc in locs:
+            lat, lon = float(loc.latitude), float(loc.longitude)
+            seg = haversine_m(prev[0], prev[1], lat, lon) if prev else 0.0
+            gap = int((loc.timestamp - prev[2]).total_seconds() // 60) if prev else 0
+            total += seg
+            if not loc.inside_project:
+                outside += 1
+            points.append({
+                'id': loc.id,
+                'latitude': lat,
+                'longitude': lon,
+                'timestamp': loc.timestamp,
+                'zone': loc.current_zone,
+                'project_name': loc.project_name,
+                'inside_project': loc.inside_project,
+                'segment_meters': round(seg, 1),
+                'gap_minutes': gap,
+            })
+            prev = (lat, lon, loc.timestamp)
+
+        att = (
+            Attendance.objects.filter(worker=worker, check_in__gte=start - timedelta(hours=12), check_in__lt=end)
+            .order_by('-check_in').first()
+        )
+        pic = ProfilePicture.objects.filter(user=worker).values_list('updated_at', flat=True).first()
+        duration = int((locs[-1].timestamp - locs[0].timestamp).total_seconds() // 60) if len(locs) > 1 else 0
+
+        return Response({
+            'worker': {
+                'id': worker.id,
+                'username': worker.username,
+                'full_name': _name(worker),
+                'has_profile_picture': pic is not None,
+                'profile_picture_updated_at': pic,
+            },
+            'from': start,
+            'to': end,
+            'points': points,
+            'summary': {
+                'point_count': len(points),
+                'distance_meters': round(total, 1),
+                'first_timestamp': locs[0].timestamp if locs else None,
+                'last_timestamp': locs[-1].timestamp if locs else None,
+                'duration_minutes': duration,
+                'outside_project_points': outside,
+                'truncated': len(locs) >= MAX_PATH_POINTS,
+            },
+            'attendance': {
+                'status': att.status,
+                'check_in': att.check_in,
+                'check_out': att.check_out,
+                'total_duration_seconds': (
+                    att.total_duration.total_seconds() if att.total_duration else None
+                ),
+            } if att else None,
+        })
+
