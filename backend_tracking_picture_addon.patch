+# ── profile picture ────────────────────────────────────────────────────────
+
+def _detect_type(b: bytes):
+    if b[:3] == b'\xff\xd8\xff':
+        return 'image/jpeg'
+    if b[:8] == b'\x89PNG\r\n\x1a\n':
+        return 'image/png'
+    if b[:4] == b'RIFF' and b[8:12] == b'WEBP':
+        return 'image/webp'
+    return None
+
+
+class ProfilePictureView(APIView):
+    permission_classes = [IsAuthenticated]
+
+    def _target(self, request, user_id, write):
+        target = User.objects.filter(pk=user_id).first()
+        if target is None:
+            return None, Response({'detail': 'User not found.'}, status=http.HTTP_404_NOT_FOUND)
+        me = request.user
+        if me.pk == target.pk or me.is_superuser or _can_view_tracking(me):
+            return target, None
+        if not write and _is_manager(me):
+            return target, None
+        return None, _forbidden('You cannot access this profile picture.')
+
+    def get(self, request, user_id):
+        target, err = self._target(request, user_id, write=False)
+        if err:
+            return err
+        pic = ProfilePicture.objects.filter(user=target).first()
+        if pic is None:
+            return Response({'detail': 'No profile picture.'}, status=http.HTTP_404_NOT_FOUND)
+        resp = HttpResponse(bytes(pic.image), content_type=pic.content_type)
+        resp['Cache-Control'] = 'private, max-age=300'
+        resp['ETag'] = f'"{int(pic.updated_at.timestamp())}"'
+        return resp
+
+    def post(self, request, user_id):
+        target, err = self._target(request, user_id, write=True)
+        if err:
+            return err
+        raw = str(request.data.get('image_base64') or '')
+        if raw.startswith('data:') and ',' in raw:
+            raw = raw.split(',', 1)[1]
+        try:
+            data = base64.b64decode(raw, validate=False)
+        except (binascii.Error, ValueError):
+            return Response({'image_base64': 'Not valid base64.'}, status=http.HTTP_400_BAD_REQUEST)
+        if not data:
+            return Response({'image_base64': 'An image is required.'}, status=http.HTTP_400_BAD_REQUEST)
+        if len(data) > MAX_PICTURE_BYTES:
+            return Response(
+                {'image_base64': f'Image is larger than {MAX_PICTURE_BYTES // 1024} KB.'},
+                status=http.HTTP_400_BAD_REQUEST,
+            )
+        ctype = _detect_type(data)
+        if ctype is None:
+            return Response({'image_base64': 'Only JPEG, PNG or WEBP images are allowed.'}, status=http.HTTP_400_BAD_REQUEST)
+        pic, _ = ProfilePicture.objects.update_or_create(
+            user=target, defaults={'image': data, 'content_type': ctype, 'size_bytes': len(data)}
+        )
+        return Response(
+            {'user_id': target.id, 'content_type': ctype, 'size_bytes': len(data), 'updated_at': pic.updated_at},
+            status=http.HTTP_201_CREATED,
+        )
+
+    put = post
+
+    def delete(self, request, user_id):
+        target, err = self._target(request, user_id, write=True)
+        if err:
+            return err
+        ProfilePicture.objects.filter(user=target).delete()
+        return Response(status=http.HTTP_204_NO_CONTENT)
