+"""
+ProfilePicture model (kept in its own module so models.py only needs ONE import line).
+
+models.py must end with:
+    from .profile_picture_model import ProfilePicture  # noqa: E402,F401
+"""
+from django.contrib.auth.models import User
+from django.db import models
+
+
+class ProfilePicture(models.Model):
+    """Profile photo of a user, stored in the database (small JPEG/PNG/WEBP, max 300 KB)."""
+
+    user = models.OneToOneField(User, on_delete=models.CASCADE, related_name='profile_picture')
+    image = models.BinaryField()
+    content_type = models.CharField(max_length=30, default='image/jpeg')
+    size_bytes = models.PositiveIntegerField(default=0)
+    updated_at = models.DateTimeField(auto_now=True)
+
+    class Meta:
+        app_label = 'accounts'
+
+    def __str__(self):
+        return f'ProfilePicture({self.user_id}, {self.size_bytes} bytes)'
